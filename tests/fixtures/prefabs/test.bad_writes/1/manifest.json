{
  "schema": "jarvis.prefab",
  "schema_version": 1,
  "id": "test.bad_writes",
  "version": 1,
  "title": "Counter",
  "description": "Test fixture: a counter with a state event and a notify event.",
  "family": "window",
  "tags": [
    "test",
    "counter"
  ],
  "aliases": [
    "compteur"
  ],
  "scene": {
    "kind": "window",
    "default_size": {
      "w": 40,
      "h": 24
    }
  },
  "inputs": {
    "props": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "max_length": 40,
          "default": "Count"
        },
        "accent": {
          "type": "color",
          "default": "#6ee7ff"
        },
        "mode": {
          "type": "enum",
          "values": [
            "compact",
            "full"
          ],
          "default": "full"
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "min": 0,
          "max": 1000000
        },
        "notes": {
          "type": "text",
          "format": "markdown",
          "max_length": 500,
          "default": ""
        },
        "link": {
          "type": "url"
        },
        "history": {
          "type": "array",
          "max_items": 8,
          "default": [],
          "items": {
            "type": "object",
            "required": [
              "delta"
            ],
            "properties": {
              "delta": {
                "type": "integer",
                "min": -100,
                "max": 100
              },
              "ratio": {
                "type": "number",
                "min": 0,
                "max": 1,
                "default": 0.5
              }
            }
          }
        }
      }
    }
  },
  "events": {
    "incremented": {
      "class": "state",
      "writes": [
        "unknown_key"
      ],
      "summary": "User changed the count",
      "payload": {
        "type": "object",
        "properties": {
          "count": {
            "$ref": "data.count"
          },
          "history": {
            "$ref": "data.history"
          }
        }
      }
    },
    "reset_requested": {
      "class": "notify",
      "summary": "User asked for a reset",
      "payload": {
        "type": "object",
        "properties": {
          "from": {
            "type": "integer",
            "min": 0
          }
        }
      }
    }
  },
  "sample": {
    "props": {},
    "data": {
      "count": 3
    }
  },
  "files": {
    "template": "template.html",
    "style": "style.css",
    "behavior": "behavior.js"
  }
}
