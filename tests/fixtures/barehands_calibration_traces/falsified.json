{
  "name": "falsified",
  "description": "Hypothèse démentie par un essai (Slice 06 adaptative, décision 52). « Le release colle » : la première cause essayée (confirmation trop lente) ne change rien aux mesures, sa confiance baisse, elle ne peut plus être réessayée ni reproposée sans preuve nouvelle ; une autre cause est testée, améliore, et n'est gardée que sur l'accord vérifié de l'utilisateur. Fixture rejouée sous node contre la vraie séance (`test_barehands_calibration_agent_js.py`) et référence pour la trace du vrai cerveau (QA, brain8 adapté).",
  "steps": [
    {"op": "measure", "rows": {"ep-1": {"release_latency_ms": 240}, "ep-2": {"release_latency_ms": 260}, "ep-3": {"release_latency_ms": 250}}},
    {"op": "feedback", "payload": {"categories": ["release_sticky"], "text": "le release colle"},
     "expect": {"ok": true, "result.feedback.ref": "fb-1", "result.suggestedCauses": ["release_threshold_too_far", "release_confirmation_too_slow"]}},
    {"op": "hypothesis", "payload": {"cause": "release_confirmation_too_slow", "confidence": 0.6,
      "evidence": [{"metric": "release_latency_ms", "aggregate": "p50", "sourceRefs": ["ep-1", "ep-2", "ep-3"]}], "feedbackRefs": ["fb-1"]},
     "expect": {"ok": true, "result.hypothesis.ref": "hy-1", "result.hypothesis.status": "open", "result.evidence.0.value": 250,
       "result.hypothesis.trialKeys": ["releaseFrames", "releaseMs"]}},
    {"op": "apply", "payload": {"hypothesisRef": "hy-1", "patch": {"releaseMs": 20}},
     "expect": {"ok": true, "result.trialRef": "tr-1", "result.applied.releaseMs": 20, "result.baseRef": null}},
    {"op": "measure", "rows": {"ep-4": {"release_latency_ms": 250}, "ep-5": {"release_latency_ms": 245}, "ep-6": {"release_latency_ms": 255}}},
    {"op": "feedback", "payload": {"categories": ["release_sticky"], "text": "ça colle toujours"},
     "expect": {"ok": true, "result.feedback.ref": "fb-2"}},
    {"op": "resolve", "payload": {"trialRef": "tr-1", "verdict": "improved", "comparisons": [{"metric": "release_latency_ms", "aggregate": "p50"}],
      "beforeRefs": ["ep-1", "ep-2", "ep-3"], "afterRefs": ["ep-4", "ep-5", "ep-6"], "feedbackRefs": ["fb-2"]},
     "why": "l'agent ne peut pas déclarer « mieux » contre la parole de l'utilisateur",
     "expect": {"ok": false, "code": "barehands_calibration_refused", "errors.0.code": "barehands_trial_feedback_contradicts"}},
    {"op": "resolve", "payload": {"trialRef": "tr-1", "verdict": "improved", "comparisons": [{"metric": "release_latency_ms", "aggregate": "p50"}],
      "beforeRefs": ["ep-4"], "afterRefs": ["ep-1"], "feedbackRefs": []},
     "why": "une mesure d'avant ne passe pas pour une mesure d'après",
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_refs_misplaced"}},
    {"op": "resolve", "payload": {"trialRef": "tr-1", "verdict": "no_change", "comparisons": [{"metric": "release_latency_ms", "aggregate": "p50"}],
      "beforeRefs": ["ep-1", "ep-2", "ep-3"], "afterRefs": ["ep-4", "ep-5", "ep-6"], "feedbackRefs": ["fb-2"]},
     "expect": {"ok": true, "result.deltas.0.before": 250, "result.deltas.0.after": 250, "result.deltas.0.direction": "same",
       "result.hypotheses.0.before": 0.6, "result.hypotheses.0.confidence": 0.36, "result.hypotheses.0.status": "weakened"}},
    {"op": "apply", "payload": {"hypothesisRef": "hy-1", "patch": {"releaseMs": 10}},
     "why": "un essai démenti ne se répète pas",
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_hypothesis_disproven"}},
    {"op": "hypothesis", "payload": {"cause": "release_confirmation_too_slow", "confidence": 0.5,
      "evidence": [{"metric": "release_latency_ms", "aggregate": "p95", "sourceRefs": ["ep-1", "ep-2", "ep-3"]}], "feedbackRefs": ["fb-1"]},
     "why": "la même cause ne revient pas sans preuve postérieure au démenti",
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_hypothesis_disproven"}},
    {"op": "rollback", "expect": {"ok": true, "result.trialRef": "tr-1", "result.undone": ["tr-1"], "result.active": null}},
    {"op": "hypothesis", "payload": {"cause": "release_threshold_too_far", "confidence": 0.5, "evidence": [], "feedbackRefs": ["fb-2"]},
     "expect": {"ok": true, "result.hypothesis.ref": "hy-2"}},
    {"op": "apply", "payload": {"hypothesisRef": "hy-2", "patch": {"releaseDeltaRatio": 0.1}},
     "expect": {"ok": true, "result.trialRef": "tr-2", "result.baseRef": null}},
    {"op": "measure", "rows": {"ep-7": {"release_latency_ms": 120}, "ep-8": {"release_latency_ms": 130}, "ep-9": {"release_latency_ms": 110}}},
    {"op": "feedback", "payload": {"categories": ["fine"], "text": "là c'est nickel"}, "expect": {"ok": true, "result.feedback.ref": "fb-3"}},
    {"op": "resolve", "payload": {"trialRef": "tr-2", "verdict": "improved", "comparisons": [{"metric": "release_latency_ms", "aggregate": "p50"}],
      "beforeRefs": ["ep-1", "ep-2", "ep-3"], "afterRefs": ["ep-7", "ep-8", "ep-9"], "feedbackRefs": ["fb-3"]},
     "expect": {"ok": true, "result.deltas.0.delta": -130, "result.deltas.0.direction": "better",
       "result.hypotheses.0.confidence": 0.725, "result.hypotheses.0.status": "open"}},
    {"op": "accept", "payload": {"consent": {"source": "voice", "quote": "garde-le"}},
     "why": "un accord que le Control Center n'a pas vérifié n'en est pas un",
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_consent_missing"}},
    {"op": "accept", "payload": {"consent": {"source": "voice", "quote": "oui garde-le", "verifiedBy": "control_center"}},
     "expect": {"ok": true, "result.trialRef": "tr-2", "result.accepted.releaseDeltaRatio": 0.1, "result.consent.quote": "oui garde-le"}}
  ]
}
