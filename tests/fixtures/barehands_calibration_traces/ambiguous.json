{
  "name": "ambiguous",
  "description": "Retour ambigu (Slice 06 adaptative, grill-session : « j'ai du mal à viser, ça lag »). Deux causes plausibles restent ouvertes côte à côte ; un seul essai à la fois, dans les clés de sa cause ; un essai sans effet net (inconclusive) ne touche pas la confiance ; l'alternative est testée ensuite. Fixture rejouée sous node contre la vraie séance (`test_barehands_calibration_agent_js.py`) et référence pour la trace du vrai cerveau (QA).",
  "steps": [
    {"op": "measure", "rows": {"ex-1": {"acquisition_ms": 900, "reacquisition_count": 3, "target_ambiguity": 0.9}}},
    {"op": "feedback", "payload": {"categories": ["hard_to_aim", "laggy"], "text": "j'ai du mal à viser, je me suis repris plusieurs fois, ça lag"},
     "expect": {"ok": true, "result.suggestedCauses": ["target_assist_too_weak", "pointer_filter_too_noisy", "pointer_filter_too_smooth", "user_learning", "release_confirmation_too_slow"]}},
    {"op": "hypothesis", "payload": {"cause": "target_assist_too_weak", "confidence": 0.4,
      "evidence": [{"metric": "acquisition_ms", "aggregate": "mean", "sourceRefs": ["ex-1"]}], "feedbackRefs": ["fb-1"]},
     "expect": {"ok": true, "result.hypothesis.ref": "hy-1", "result.evidence.0.value": 900}},
    {"op": "hypothesis", "payload": {"cause": "pointer_filter_too_smooth", "confidence": 0.95, "evidence": [], "feedbackRefs": ["fb-1"]},
     "why": "une hypothèse naît modeste : la confiance initiale est plafonnée",
     "expect": {"ok": true, "result.hypothesis.ref": "hy-2", "result.hypothesis.confidence": 0.8}},
    {"op": "hypothesis", "payload": {"cause": "target_assist_too_weak", "confidence": 0.5, "evidence": [], "feedbackRefs": ["fb-1"]},
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_hypothesis_duplicate"}},
    {"op": "hypothesis", "payload": {"cause": "user_learning", "confidence": 0.3,
      "evidence": [{"metric": "acquisition_ms", "aggregate": "mean", "sourceRefs": ["ex-9"]}], "feedbackRefs": []},
     "why": "une mesure citée et introuvable n'est pas une mesure",
     "expect": {"ok": false, "errors.0.code": "barehands_measurement_missing"}},
    {"op": "apply", "payload": {"hypothesisRef": "hy-2", "patch": {"assistance": 0.8}},
     "why": "un essai reste dans les clés de sa cause",
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_trial_off_hypothesis"}},
    {"op": "apply", "payload": {"hypothesisRef": "hy-1", "patch": {"assistance": 0.8}},
     "expect": {"ok": true, "result.trialRef": "tr-1"}},
    {"op": "apply", "payload": {"hypothesisRef": "hy-2", "patch": {"minCutoffHz": 2}},
     "why": "un seul essai non jugé à la fois : l'issue doit dire laquelle a compté",
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_trial_unresolved"}},
    {"op": "measure", "rows": {"ex-2": {"acquisition_ms": 880, "reacquisition_count": 3, "target_ambiguity": 0.85}}},
    {"op": "resolve", "payload": {"trialRef": "tr-1", "verdict": "inconclusive", "comparisons": [],
      "beforeRefs": [], "afterRefs": ["ex-1"], "feedbackRefs": []},
     "why": "une mesure prise avant l'essai ne se cite pas comme mesure « après »",
     "expect": {"ok": false, "errors.0.code": "barehands_calibration_refs_misplaced"}},
    {"op": "resolve", "payload": {"trialRef": "tr-1", "verdict": "inconclusive", "comparisons": [{"metric": "acquisition_ms", "aggregate": "mean"}],
      "beforeRefs": ["ex-1"], "afterRefs": ["ex-2"], "feedbackRefs": []},
     "expect": {"ok": true, "result.deltas.0.delta": -20, "result.hypotheses.0.confidence": 0.32, "result.hypotheses.0.status": "open"}},
    {"op": "rollback", "expect": {"ok": true, "result.undone": ["tr-1"]}},
    {"op": "apply", "payload": {"hypothesisRef": "hy-2", "patch": {"minCutoffHz": 2}},
     "expect": {"ok": true, "result.trialRef": "tr-2", "result.hypothesisRef": "hy-2"}},
    {"op": "status", "expect": {"ok": true, "result.hypotheses.0.status": "open", "result.hypotheses.1.status": "open",
      "result.trials.0.state": "rolled_back", "result.trials.1.state": "active", "result.measurementCount": 2}}
  ]
}
