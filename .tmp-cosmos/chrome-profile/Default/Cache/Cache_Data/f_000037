function voiceChanged(element,revision){
  const meta=voiceOption(element.dataset.voiceMeta),persistence=element.dataset.voicePersistence;
  if(!meta||!persistence)return;
  const value=element.type==='checkbox'?element.checked:element.type==='number'&&element.value!==''?Number(element.value):element.value;
  if(persistence==='voice_stack')SET.draft.voice.stack=value;
  else if(persistence==='voice_arch')SET.draft.voice.arch=value;
  else if(persistence.startsWith('voice_stack_settings.')){
    const parts=persistence.split('.'),scope=parts[1],key=parts.slice(2).join('.');SET.draft.voice.settings[scope][key]=value;
  }else if(persistence==='audio_input_device')SET.draft.audio.input_device=element.value;
  else if(persistence==='audio_output_device')SET.draft.audio.output_device=element.value;
  else if(persistence==='active_timeout_s')SET.draft.audio.active_timeout_s=element.value;
  else{authFieldChanged({dataset:{field:persistence},value:element.value},revision);return}
  SET.dirty=true;
  if((SET.data.voice.option_metadata||[]).some(item=>String(item.depends_on||'').startsWith(meta.id+'=')))renderVoicePanel(revision);
  else say('Modifications non enregistrées.','');
}
function bindVoiceModelField(meta,revision){
  const field=$(`#${voiceOptionId(meta)}_field`);if(!field)return;
  const select=field.querySelector('[data-voice-persistence]');
  if(select)select.addEventListener('change',()=>voiceChanged(select,revision));
  const retry=field.querySelector('[data-voice-model-retry]');
  if(retry)retry.addEventListener('click',()=>hydrateVoiceModel(meta,revision,true));
