    for(const circle of shapes.rings){
      const mark=doc.createElementNS(SVG_NS,'circle');
      mark.setAttribute('cx',num(circle.cx));mark.setAttribute('cy',num(circle.cy));
      mark.setAttribute('r',num(circle.r));
