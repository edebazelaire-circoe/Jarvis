/* Menu contextuel générique (cartes d'agents, objets de la scène — Slice 08) :
   même composant, même clavier (flèches, Début, Fin, Échap, Tab, touche Menu).
   `run(act)` reçoit l'action choisie, menu déjà fermé ; sans `run`, l'action
   va aux cartes d'agents (`runMenuAction`). */
function showMenu({title,items,pos,origin,id=null,run=null}){
  closeMenu(false);
  ctxMenu.innerHTML=`<div class="mhead">${esc(title)}</div>`+items.map(it=>it==='-'
    ?'<div class="sep" role="separator"></div>'
    :`<button type="button" role="menuitem" data-act="${esc(it.act)}" class="${it.danger?'danger':''}"${it.disabled?' disabled':''}${it.note?' aria-disabled="true"':''}><span>${esc(it.label)}</span>${it.key?`<kbd>${esc(it.key)}</kbd>`:''}</button>`).join('');
  ctxMenu.setAttribute('aria-label',`Actions : ${title}`);
  ctxMenu.style.left='0px';ctxMenu.style.top='0px';
  ctxMenu.hidden=false;
  const w=ctxMenu.offsetWidth,h=ctxMenu.offsetHeight,W=window.innerWidth,H=window.innerHeight;
  let x=pos.alignRight?pos.alignRight-w:pos.x,y=pos.y;
  if(x+w>W-8)x=W-w-8;
  if(y+h>H-8)y=(pos.above??y)-h;
