        rings.push(Object.freeze({cx:mark.at[0],cy:mark.at[1],r:mark.r,dashed:!!mark.dashed}));
      else reject('barehands_hand_mark_unknown',
        `Marque inconnue dans la posture ${record.id} : ${String(mark.shape)}.`);
    }
