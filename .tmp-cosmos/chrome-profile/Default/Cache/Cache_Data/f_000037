      : T.statusHtml(S.status);
  }
  function renderList(){
    if(S.catalogError){el.list.innerHTML=T.noticeHtml('bad','Catalogue illisible',S.catalogError,null);return}
    const rows=T.catalogueRows(S.diagnostics,S.filter);
    if(!rows.length){
