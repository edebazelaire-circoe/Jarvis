    if(!S.followed||S.cancelling)return;
    S.cancelling=true;renderRun();
    try{
      await post(`${T.ROUTE}/runs/${encodeURIComponent(S.followed)}/cancel`,{reason:'demandé depuis le Control Center'});
      announce('Arrêt demandé.');notice(null);
