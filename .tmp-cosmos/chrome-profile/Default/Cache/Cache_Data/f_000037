    TRACE_SCHEMA,TRACE_SCHEMA_VERSION,DEFAULTS,options,
    BLANK_HAND,BLANK_CANDIDATE,BLANK_EVENT,BLANK_GESTURE,BLANK_FRAME,
    TRACE_KINDS,TRACE_KIND_OTHER,
