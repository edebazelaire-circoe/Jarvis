  const field=$(`#${voiceOptionId(meta)}_field`);if(!field)return;
  field.outerHTML=voiceOptionHtml(meta);bindVoiceModelField(meta,revision);
}
function voiceProviderModelSource(meta){
  if(meta.type!=='catalog-select'||!String(meta.persistence||'').startsWith('voice_stack_settings.'))return null;
  const parts=String(meta.source||'').split(':');
  if(parts.length!==2||!parts.every(part=>/^[a-z0-9_-]+$/.test(part)))return null;
  return {provider:parts[0],role:parts[1]};
}
async function hydrateVoiceModel(meta,revision,refresh=false){
  const source=voiceProviderModelSource(meta);if(!currentVoicePanel(revision,'models')||!source)return;
  const previous=(SET.voiceModelSources||{})[meta.id];if(previous&&previous.status==='ready'&&!refresh)return;
  const {provider,role}=source,requestId=((SET.voiceModelGenerations||{})[meta.id]||0)+1,panelGeneration=SET.voiceGeneration;
  SET.voiceModelGenerations[meta.id]=requestId;SET.voiceModelSources[meta.id]={...previous,status:'loading',error:''};renderVoiceModelField(meta,revision);
  const result=await requestCatalog(provider,role,refresh);
  if(!currentVoicePanel(revision,'models')||panelGeneration!==SET.voiceGeneration||SET.voiceModelGenerations[meta.id]!==requestId)return;
  SET.voiceModelSources[meta.id]={status:result.ok?'ready':'error',error:result.error||'',result};renderVoiceModelField(meta,revision);
}
function bindVoicePanel(revision){
  const panel=$('#voicePanel');if(!panel)return;
