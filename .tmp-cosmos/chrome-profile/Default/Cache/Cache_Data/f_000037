      .concat(shapes.dots.map(dot=>
        `<circle cx="${num(dot.cx)}" cy="${num(dot.cy)}" r="${num(dot.r)}" fill="currentColor" stroke="none"/>`))
      .concat(shapes.rings.map(circle=>
