  try{
    if(!BG.ctx){const C=window.AudioContext||window.webkitAudioContext;if(!C)return;BG.ctx=new C()}
    if(BG.ctx.state==='suspended')BG.ctx.resume().catch(()=>{});
    const now=BG.ctx.currentTime,notes=bad?[392,294]:[784,1047];
    notes.forEach((hz,i)=>{
      const osc=BG.ctx.createOscillator(),gain=BG.ctx.createGain(),at=now+i*0.11;
      osc.type='sine';osc.frequency.value=hz;
      gain.gain.setValueAtTime(0,at);
      gain.gain.linearRampToValueAtTime(bad?0.06:0.04,at+0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001,at+0.1);
      osc.connect(gain).connect(BG.ctx.destination);osc.start(at);osc.stop(at+0.12);
    });
  }catch(e){/* pas de son : les pastilles suffisent */}
}

/* Catégories dans l'ordre du registre : la plus urgente d'abord, au plus près
   du bouton Agents. `one`/`many` : libellés accordés au compte. */
const BG_CATS=[
  {id:'failed',one:'échec',many:'échecs',icon:'⛔',tone:'bad'},
  {id:'attention',one:'point à vérifier',many:'points à vérifier',icon:'❓',tone:'warn'},
  {id:'done',one:'tâche terminée',many:'tâches terminées',icon:'✅',tone:'ok'},
  {id:'said',one:'résultat non dit',many:'résultats non dits',icon:'🔇',tone:'info'},
];
const bgCat=id=>BG_CATS.find(c=>c.id===id)||{id,one:id,many:id,icon:'•',tone:'info'};
const bgCount=(cat,n)=>`${n} ${n>1?cat.many:cat.one}`;

/* Les pastilles suivent le résumé de `/api/status` (sondé chaque seconde) :
   le DOM n'est réécrit que si un compte change, pour ne pas voler le focus. */
function renderBackgroundPills(bg){
  const box=$('#bgPills');if(!box)return;
  const summary=bg||{},counts=summary.counts||{},unread=Number(summary.unread||0);
  const seq=Number(summary.seq||0),bad=!!(counts.failed||counts.attention);
  const shown=BG_CATS.filter(c=>Number(counts[c.id])>0);
  const sig=shown.map(c=>`${c.id}:${counts[c.id]}`).join('|');
  if(sig!==BG.sig){
    BG.sig=sig;
    box.innerHTML=shown.map(c=>{
      const n=Number(counts[c.id]),label=`Arrière-plan · ${bgCount(c,n)}`,open=BG.open===c.id;
      return `<button type="button" class="bgpill ${c.tone}${open?' active':''}" data-bg-cat="${c.id}" title="${esc(label)}" aria-label="${esc(label)}" aria-haspopup="dialog" aria-expanded="${open}">${n>9?'9+':n}</button>`;
    }).join('');
    box.hidden=!shown.length;
  }
  // La catégorie ouverte a été vue ailleurs (autre fenêtre) : rien à montrer.
  if(BG.open&&!Number(counts[BG.open]))closeBackgroundPop();
  /* Hausse réelle : on signale. `armed` évite de sonner au tout premier
     sondage, où tout est « nouveau » par construction. */
  if(BG.armed&&seq>BG.seq&&unread>0)bgCue(bad);
  BG.seq=seq;BG.armed=true;
}

/* Carte Agents d'un événement : la trace nomme l'id du tracker, la carte Core
   porte le work_key — les deux sont essayés. */
function bgTaskFor(id){
  if(!id)return null;
  return allTasks().find(t=>t.id===id||t.provider_id===id)||AG.cache.get(id)||null;
}

function placeBackgroundPop(pill){
  const pop=$('#bgPop'),r=pill.getBoundingClientRect(),w=window.innerWidth,h=window.innerHeight;
  const row=getComputedStyle($('#bgPills')).flexDirection.startsWith('row');
  if(row){
    // Pastilles en ligne (thème Cosmos) : la liste tombe sous la pastille.
    pop.style.top=`${Math.round(r.bottom+10)}px`;
    pop.style.right=`${Math.max(10,Math.round(w-r.right-12))}px`;
  }else{
    // Pastilles en colonne : la liste s'ouvre à leur gauche, bornée à l'écran.
    pop.style.right=`${Math.round(w-r.left+12)}px`;
    pop.style.top=`${Math.round(Math.max(12,Math.min(r.top-12,h-pop.offsetHeight-12)))}px`;
  }
}

function closeBackgroundPop(){
  const pop=$('#bgPop');
  BG.open=null;
  if(pop){pop.hidden=true;pop.innerHTML=''}
  document.querySelectorAll('#bgPills .bgpill').forEach(p=>{p.classList.remove('active');p.setAttribute('aria-expanded','false')});
}

async function openBackgroundPop(category,pill){
  if(BG.open===category){closeBackgroundPop();return}
  closeBackgroundPop();
  const cat=bgCat(category),pop=$('#bgPop');
  BG.open=category;
