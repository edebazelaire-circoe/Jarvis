<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>JARVIS</title>
<style>
:root{color-scheme:dark;--bg:#05080b;--panel:rgba(6,12,18,.94);--solid:#070d13;--line:#183343;--text:#d8edf7;--muted:#7190a0;--accent:#6ee7ff;--danger:#ff6577;--ok:#68e0a0;--warn:#ffb85c}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--bg);color:var(--text);font:15px ui-monospace,SFMono-Regular,Consolas,monospace;overflow:hidden;cursor:default}
#app{position:relative;width:100%;height:100%}
/* Registre d'empilement (Slice 05). Le visage (0) et le canevas Cosmos (0) sont
   au fond ; la scène constellation (20, conteneur #sceneLayer créé par
   control_center_scene_page.js seulement si scene.enabled) passe au-dessus ;
   toute commande de la page reste au-dessus de la scène : barre du haut et
   indication vocale 31, palette d'outils Bare Hands 30 (Slice 03 : juste
   SOUS le contrôle de cycle de vie et son sélecteur, qu'elle jouxte sur le
   bord gauche — le sélecteur s'ouvre par-dessus elle et ne doit jamais se
   faire recouvrir par la colonne d'icônes qu'il masque le temps d'un choix),
   dock 32, contrôle Bare Hands du haut-gauche 32 (même
   rang que le dock : c'est une commande de page de la même classe, de l'autre
   côté de l'écran) et son sélecteur de mode 36 (juste au-dessus du bandeau
   GPT-Live, qu'un choix ouvert par l'utilisateur doit pouvoir recouvrir, et
   sous les pastilles et les modales, qui le recouvrent), panneau 33, bandeau GPT-Live 35, pastilles
   40, chronologie de conversation 55 (modale plein écran `.tl`), fond des
   réglages 60, notifications 70, liste des pastilles 75, menu
   contextuel 80 — un seul `.ctxmenu` partagé : cartes d'agents, objets de la
   scène et, depuis la Slice 02, les quatre actions rapides du contrôle Bare
   Hands ; 80 est au-dessus du sélecteur de mode (36), donc le menu recouvre
   bien le sélecteur qu'il remplace et non l'inverse —,
   cartes rapides Bare Hands 82 (Slice 04 : Aide / Gestes et Diagnostic,
   ouvertes **depuis** le menu contextuel, donc au-dessus de ses 80 — une carte
   qui se ferait recouvrir par le menu qui l'a ouverte serait illisible — et en
   dessous de la confirmation en page, qui doit pouvoir les recouvrir),
   confirmation en page 85, Barehands 2147483000. Thème Cosmos :
   panneau 42, barre 45, bandeau 48, dock et pastilles 50. Les couches de la
   scène (0–1000) ne s'empilent qu'à l'intérieur de son conteneur ; les rangs
   internes de la chronologie (`.tl-*`, 1–30) et de l'écran d'aiguillage (aucun :
   un profil éteint se marque par `.routing-off` et par `disabled`, jamais par
   une superposition) restent dans leur propre conteneur. L'ordre est vérifié
   par `tests/unit/test_scene_renderer_logic.py`. */
.face{position:absolute;inset:0;z-index:0;width:100%;height:100%;border:0;background:#000;pointer-events:none;cursor:default}
.topbar{position:absolute;z-index:31;top:18px;left:18px;right:18px;display:flex;justify-content:space-between;align-items:center;pointer-events:none}
.brand,.state,.voicehint{background:rgba(3,8,12,.72);border:1px solid rgba(110,231,255,.18);backdrop-filter:blur(10px);padding:8px 12px;letter-spacing:.14em;text-transform:uppercase}
.state{font-size:12px;color:var(--muted)}
.state strong{color:var(--accent)}
.voicehint{position:absolute;z-index:31;left:50%;bottom:22px;transform:translateX(-50%);font-size:12px;color:var(--accent);pointer-events:none;box-shadow:0 0 30px rgba(0,0,0,.35)}
.live-banner{position:absolute;z-index:35;top:68px;left:50%;transform:translateX(-50%);width:min(720px,calc(100vw - 170px));display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:14px;align-items:center;padding:12px 14px;background:rgba(35,7,12,.94);border:2px solid var(--danger);border-radius:10px;box-shadow:0 0 32px rgba(255,101,119,.28);pointer-events:auto}
.live-banner.uncertain{border-color:var(--warn);background:rgba(38,23,5,.96);box-shadow:0 0 32px rgba(255,184,92,.24)}
.live-led{width:13px;height:13px;border-radius:50%;background:var(--danger);box-shadow:0 0 15px var(--danger);animation:pulse 1.2s ease-in-out infinite}
.live-banner.uncertain .live-led{background:var(--warn);box-shadow:0 0 15px var(--warn)}
.live-main{min-width:0}.live-title{font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#fff}.live-title strong{color:var(--danger)}
.live-banner.uncertain .live-title strong{color:var(--warn)}
.live-meta{margin-top:4px;font-size:11px;color:#d9b9bf;line-height:1.45}.live-banner.uncertain .live-meta{color:#ead1ae}.live-warning{display:block;color:var(--warn);margin-top:3px}
.live-stop{border:1px solid var(--danger);background:#26070c;color:#fff;padding:9px 13px;border-radius:7px;font:700 12px inherit;letter-spacing:.08em;cursor:pointer}.live-stop:hover{background:#3c0a12}.live-stop:disabled{opacity:.6;cursor:wait}
.dock{position:absolute;z-index:32;right:18px;top:50%;transform:translateY(-50%);display:grid;gap:10px}
.dock button{width:52px;height:52px;border:1px solid rgba(110,231,255,.26);background:rgba(3,8,12,.82);color:var(--text);border-radius:10px;cursor:pointer;font:12px inherit;backdrop-filter:blur(12px)}
.dock button:hover,.dock button.active{border-color:var(--accent);color:var(--accent)}
.badge{position:absolute;right:-5px;top:-5px;min-width:18px;height:18px;border-radius:9px;background:var(--danger);color:white;font-size:10px;display:none;align-items:center;justify-content:center}
.tool{position:relative}
.panel{position:absolute;z-index:33;top:18px;right:86px;bottom:18px;width:min(560px,calc(100% - 120px));background:var(--panel);border:1px solid var(--line);backdrop-filter:blur(18px);display:none;flex-direction:column;box-shadow:0 0 50px rgba(0,0,0,.45)}
.panel.open{display:flex}
.panel header{display:flex;justify-content:space-between;align-items:center;padding:15px 17px;border-bottom:1px solid var(--line)}
.panel header h2{font-size:14px;margin:0;letter-spacing:.12em;text-transform:uppercase}
.panel header button{background:none;color:var(--muted);border:0;font-size:20px;cursor:pointer}
.body{padding:16px;overflow:auto;min-height:0}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.statusdot{width:9px;height:9px;border-radius:50%;background:var(--muted)}
.statusdot.running{background:var(--ok)}
button.action{border:1px solid var(--line);background:#0b141a;color:var(--text);padding:8px 11px;border-radius:6px;cursor:pointer;font:inherit}
button.action:hover{border-color:var(--accent)}
button.action:disabled{opacity:.5;cursor:wait}
button.danger:hover{border-color:var(--danger);color:var(--danger)}
button.primary{border-color:var(--accent);color:var(--accent)}
pre.log{white-space:pre-wrap;word-break:break-word;margin:0;font-size:12px;line-height:1.55;color:#a9c5d2}
.entry{padding:9px 0;border-bottom:1px solid rgba(113,144,160,.12)}
.entry .meta{font-size:10px;color:var(--muted);margin-bottom:3px}
.entry.error{color:#ff9eaa}
.entry.bgrow{display:flex;align-items:flex-start;gap:9px;padding:9px 2px}
.entry.bgrow.seen{opacity:.55}
details.entry{padding:0;border-bottom:1px solid rgba(113,144,160,.12)}
details.entry>summary{display:flex;align-items:flex-start;gap:9px;padding:9px 2px;cursor:pointer;list-style:none}
details.entry>summary::-webkit-details-marker{display:none}
details.entry>summary:hover{background:rgba(110,231,255,.05)}
.ico{flex:0 0 18px;text-align:center;font-size:13px;line-height:1.5;filter:grayscale(.25)}
.etxt{flex:1 1 auto;min-width:0}
.emsg{display:block;word-break:break-word;line-height:1.45}
.emeta{display:block;font-size:10px;color:var(--muted);margin-top:2px}
.dot{flex:0 0 9px;width:9px;height:9px;border-radius:50%;margin-top:6px;background:var(--muted)}
.dot.ok{background:var(--ok)}
.dot.warn{background:var(--warn)}
.dot.bad{background:var(--danger)}
.dot.busy{background:var(--accent)}
details.entry[open]>summary{background:rgba(110,231,255,.06)}
details.entry .detail{padding:0 2px 11px 29px}
.chip{display:inline-block;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:3px;padding:1px 5px;margin-right:6px}
.hint{font-size:11px;color:var(--muted);line-height:1.5}
.test-result{min-height:18px;font-size:12px;color:var(--muted)}
.test-result.ok{color:var(--ok)}
.test-result.error{color:var(--danger)}
textarea{width:100%;min-height:80px;background:#071015;border:1px solid var(--line);color:var(--text);padding:9px;border-radius:5px;font:inherit;resize:vertical}
.agentEvents{margin-top:14px;border-top:1px solid var(--line);padding-top:12px}
.empty{color:var(--muted);padding:20px 0;text-align:center}
[hidden]{display:none!important}

/* ---------- Panneau Agents ---------- */
.badge.count{background:var(--accent);color:#02202a;font-weight:700;box-shadow:0 0 12px rgba(110,231,255,.45);cursor:pointer}
.sechead{display:flex;align-items:center;gap:8px;margin:18px 2px 8px;font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.sechead .count{font-size:10px;border:1px solid var(--line);border-radius:9px;padding:0 6px;line-height:16px;letter-spacing:.04em}
.sechead.live .count{color:var(--accent);border-color:rgba(110,231,255,.45)}
details.sect>summary.sechead{cursor:pointer;list-style:none;border-radius:4px}
details.sect>summary::-webkit-details-marker{display:none}
details.sect>summary.sechead::before{content:'▸';font-size:10px;transition:transform .15s}
details.sect[open]>summary.sechead::before{transform:rotate(90deg)}
details.sect>summary:hover{color:var(--text)}
details.sect>summary:focus-visible{outline:1px solid var(--accent);outline-offset:3px}
.alist{display:grid;gap:8px}
.acard{position:relative;display:grid;grid-template-columns:32px minmax(0,1fr) auto;gap:12px;align-items:start;padding:11px 12px;border:1px solid var(--line);border-radius:9px;background:#060d12;outline:none;transition:border-color .15s,background-color .15s}
.acard:hover{border-color:rgba(110,231,255,.35);background:#08121a}
.acard:focus-visible{border-color:var(--accent);box-shadow:0 0 0 1px rgba(110,231,255,.4)}
.acard.brain{border-color:rgba(110,231,255,.34);background:linear-gradient(120deg,rgba(110,231,255,.09),rgba(6,13,18,.95) 58%)}
.acard.done{background:#050b10}
.acard.done .aname{color:#b9d0dc}
.acard.nested{margin-left:calc(var(--indent,1)*22px)}
.acard.nested::before{content:'';position:absolute;left:-14px;top:-9px;height:calc(50% + 9px);width:10px;border-left:1px solid var(--line);border-bottom:1px solid var(--line);border-bottom-left-radius:7px}
.acard.compact{padding:8px 11px;grid-template-columns:26px minmax(0,1fr) auto;gap:10px}
.alogo{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;border:1px solid rgba(113,144,160,.2);background:rgba(255,255,255,.025)}
.alogo svg{width:20px;height:20px;display:block}
.alogo.claude{background:rgba(217,119,87,.1);border-color:rgba(217,119,87,.3)}
.alogo.codex{background:rgba(223,232,238,.05);border-color:rgba(223,232,238,.22)}
.alogo.shell{background:rgba(104,224,160,.06);border-color:rgba(104,224,160,.25)}
.alogo .glyph{font-size:11px;font-weight:700;color:var(--ok);letter-spacing:-.04em}
.acard.compact .alogo,.toast .alogo{width:26px;height:26px;border-radius:7px}
.acard.compact .alogo svg,.toast .alogo svg{width:16px;height:16px}
.amain{min-width:0}
.aname{display:flex;align-items:center;gap:8px;min-width:0;font-weight:700;font-size:14px;letter-spacing:.02em}
.aname>span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.acard.compact .aname{font-size:13px}
.pin{flex:none;font-size:9px;font-weight:normal;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);border:1px solid rgba(110,231,255,.4);border-radius:3px;padding:0 5px;line-height:15px}
.amodel{font-size:11px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.aact{font-size:12px;color:#9dbccb;margin-top:7px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.acard.compact .aact{margin-top:4px}
.aact .sep{color:var(--muted);margin:0 6px}
.dim{color:var(--muted)}
.ameta{display:flex;flex-wrap:wrap;align-items:center;gap:3px 10px;margin-top:6px;font-size:10.5px;color:var(--muted)}
.ameta .chip{margin:0}
.chip.on{color:var(--accent);border-color:rgba(110,231,255,.45)}
.chip.bad{color:var(--danger);border-color:rgba(255,101,119,.45)}
.chip.warn{color:var(--warn);border-color:rgba(255,184,92,.45)}
.aside{display:flex;flex-direction:column;align-items:flex-end;gap:6px}
.atime{display:flex;align-items:center;gap:7px}
.timer{font-variant-numeric:tabular-nums;font-size:13px;color:#b9d0dc;letter-spacing:.02em;white-space:nowrap}
.timer.live{color:var(--accent)}
.timer.idle{color:var(--muted);font-size:12px}
.adot{width:8px;height:8px;border-radius:50%;background:var(--muted);flex:none}
.adot.running{background:var(--accent);box-shadow:0 0 8px rgba(110,231,255,.8);animation:breathe 1.6s ease-in-out infinite}
.adot.ok{background:var(--ok)}
.adot.bad{background:var(--danger)}
.adot.warn{background:var(--warn)}
@keyframes breathe{50%{opacity:.35}}
.amore{opacity:0;background:none;border:1px solid transparent;border-radius:5px;color:var(--muted);font:inherit;font-size:14px;line-height:1;padding:2px 7px 5px;cursor:pointer}
.acard:hover .amore,.acard:focus-within .amore,.acard:focus .amore{opacity:1}
.amore:hover{color:var(--accent);border-color:var(--line)}
.agfoot{margin-top:18px;text-align:center}
.agempty{border:1px dashed var(--line);border-radius:9px;padding:14px 16px;color:var(--muted);font-size:12px;line-height:1.6}
.agempty strong{color:var(--text);font-weight:normal;display:block;margin-bottom:4px}
.vbar{display:flex;align-items:center;gap:8px;margin-bottom:12px;flex-wrap:wrap}
.vbar .grow{flex:1}
button.action.small{padding:5px 9px;font-size:12px}
.kv{display:grid;grid-template-columns:max-content minmax(0,1fr);gap:7px 16px;font-size:12px;margin:0}
.kv dt{color:var(--muted)}
.kv dd{margin:0;word-break:break-word}
.dsec{margin-top:18px}
.dsec>h4{display:flex;align-items:center;gap:10px;margin:0 0 8px;font-size:10px;font-weight:normal;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
pre.block{background:#050b10;border:1px solid rgba(113,144,160,.16);border-radius:6px;padding:10px 12px;max-height:42vh;overflow:auto}
.trow .emsg.clamp{display:-webkit-box;-webkit-line-clamp:4;-webkit-box-orient:vertical;overflow:hidden;white-space:pre-wrap}
.trow[open] .emsg.clamp{display:block;-webkit-line-clamp:unset}
.trow .emsg.one{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.trow[open] .emsg.one{white-space:normal;word-break:break-word}
.trow.minor .emsg{color:var(--muted);font-size:12px}
.trow.minor>summary{padding-top:5px;padding-bottom:5px}
.trow.minor .ico{opacity:.6}
/* Compte rendu final d'une tâche : l'entrée qui compte le plus, lisible sans la déplier. */
.trow.final{margin:12px 0 6px;border:1px solid rgba(104,224,160,.32);border-left:3px solid var(--ok);border-radius:8px;background:rgba(104,224,160,.045)}
.trow.final.error{border-color:rgba(255,101,119,.35);border-left-color:var(--danger);background:rgba(255,101,119,.05)}
.trow.final>summary{padding:11px 10px 10px 8px}
.trow.final .ico{font-size:15px}
.trow.final .emsg{margin-top:6px;color:var(--text)}
.trow.final:not([open]) .emsg.clamp{-webkit-line-clamp:12}
.rhead{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;font-size:12px;letter-spacing:.06em;text-transform:uppercase}
.rhead .chip{margin:0}
.rhead .dim{text-transform:none;letter-spacing:0;font-size:11px}
.rhead .chip.ok{color:var(--ok);border-color:rgba(104,224,160,.45)}
.trow[open] .rmore{display:none}
.tname{color:var(--accent)}
.targ{color:#9dbccb}
.trow.error .tname,b.bad{color:var(--danger);font-weight:normal}
.rawjson{margin-top:8px}
.rawjson>summary{cursor:pointer;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.rawjson>summary:hover{color:var(--text)}
.newpill{position:sticky;bottom:6px;display:block;margin:10px auto 0;border:1px solid var(--accent);background:rgba(3,14,20,.95);color:var(--accent);border-radius:14px;padding:5px 14px;font:inherit;font-size:12px;cursor:pointer;box-shadow:0 6px 20px rgba(0,0,0,.5)}
.ctxmenu{position:fixed;z-index:80;left:0;top:0;min-width:220px;max-width:300px;padding:5px;background:#08121a;border:1px solid rgba(110,231,255,.3);border-radius:8px;box-shadow:0 18px 50px rgba(0,0,0,.65)}
.ctxmenu .mhead{padding:5px 10px 8px;margin-bottom:4px;border-bottom:1px solid var(--line);font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ctxmenu button{display:flex;justify-content:space-between;align-items:center;gap:18px;width:100%;padding:8px 10px;background:none;border:0;border-radius:5px;color:var(--text);font:inherit;font-size:13px;text-align:left;cursor:pointer}
.ctxmenu button:focus{outline:none;background:rgba(110,231,255,.1);color:var(--accent)}
.ctxmenu button.danger:focus{background:rgba(255,101,119,.1);color:var(--danger)}
.ctxmenu button:disabled{opacity:.38;cursor:default}
.ctxmenu button[aria-disabled="true"]{color:var(--muted);cursor:default;white-space:normal}
.ctxmenu button[aria-disabled="true"]:focus{background:rgba(110,231,255,.05);color:var(--text)}
.ctxmenu kbd{font:inherit;font-size:10px;color:var(--muted)}
.ctxmenu .sep{height:1px;background:var(--line);margin:5px 4px}
/* Confirmation en page (Slice 08) : jamais `window.confirm`. Au-dessus du menu
   (80), sous Barehands. Annuler a le focus : une action destructive se choisit. */
.cdialog-back{position:fixed;inset:0;z-index:85;display:grid;place-items:center;padding:16px;background:rgba(2,6,10,.58);backdrop-filter:blur(3px)}
.cdialog-back[hidden]{display:none}
.cdialog{width:min(440px,100%);padding:18px 18px 14px;background:#08121a;border:1px solid rgba(110,231,255,.3);border-radius:10px;box-shadow:0 24px 70px rgba(0,0,0,.7);animation:toastIn .16s ease-out}
.cdialog.danger{border-color:rgba(255,101,119,.42)}
.cdialog:focus{outline:none}
.cdialog h2{margin:0 0 10px;font-size:14px;font-weight:600;letter-spacing:.01em;text-transform:none;color:var(--text);overflow-wrap:anywhere}
.cdialog ul{margin:0 0 16px;padding:0;list-style:none;display:grid;gap:6px;font-size:12.5px;line-height:1.45;color:#b3cbd6}
.cdialog li strong{color:var(--text);font-weight:600;font-variant-numeric:tabular-nums}
.cdialog .crow{display:flex;justify-content:flex-end;gap:8px}
.cdialog button{padding:7px 14px;border-radius:6px;border:1px solid var(--line);background:rgba(3,14,20,.9);color:var(--text);font:inherit;font-size:13px;cursor:pointer}
.cdialog button:focus-visible{outline:1px solid var(--accent);outline-offset:2px}
.cdialog button.go{border-color:rgba(110,231,255,.5);color:var(--accent)}
.cdialog.danger button.go{border-color:rgba(255,101,119,.55);color:var(--danger)}
.cdialog button.go:hover{background:rgba(110,231,255,.08)}.cdialog.danger button.go:hover{background:rgba(255,101,119,.1)}
@media(prefers-reduced-motion:reduce){.cdialog{animation:none}}
.toasts{position:fixed;right:18px;bottom:18px;z-index:70;display:grid;gap:8px;width:min(340px,calc(100vw - 36px));pointer-events:none}
.toast{pointer-events:auto;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:10px;align-items:center;padding:10px 8px 10px 12px;background:rgba(6,13,19,.97);border:1px solid var(--line);border-left:2px solid var(--accent);border-radius:8px;box-shadow:0 14px 40px rgba(0,0,0,.55);animation:toastIn .18s ease-out;transition:opacity .2s,transform .2s}
.toast.ok{border-left-color:var(--ok)}
.toast.bad{border-left-color:var(--danger)}
.toast.warn{border-left-color:var(--warn)}
.toast.clickable{cursor:pointer}
.toast.clickable:hover{border-color:rgba(110,231,255,.4)}
.toast .ttxt{min-width:0}
.toast .ttxt strong{display:block;font-size:13px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.toast .ttxt span{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;font-size:11px;line-height:1.4;color:var(--muted);margin-top:2px;overflow:hidden;overflow-wrap:anywhere}
.tclose{background:none;border:0;color:var(--muted);font-size:16px;line-height:1;cursor:pointer;padding:0 4px;align-self:start}
.tclose:hover{color:var(--text)}
.toast.out{opacity:0;transform:translateY(6px)}
@keyframes toastIn{from{opacity:0;transform:translateY(8px)}}
/* Panneau ouvert : la pile passe à sa gauche, en bas, pour ne pas masquer le
   bas du panneau (dernières entrées de trace, envoi au brain). Plus étroit,
   la place manque à gauche : la pile reste à droite, comme panneau fermé. */
@media(min-width:940px){#app:has(.panel.open)~.toasts{right:calc(98px + min(560px,100vw - 120px));width:min(340px,calc(100vw - 676px))}}
@media(prefers-reduced-motion:reduce){.adot.running,.toast{animation:none}}

/* ---------- Pastilles d'arrière-plan (interface principale) ----------
   Petits boutons ronds accolés au bouton Agents, hors de la barre d'outils :
   une pastille par catégorie non vue. Dock de 6 outils (6×52 + 5×10 = 362 px,
   centré, bas à 50% + 181 px) : la colonne commence 12 px sous le dernier
   bouton. */
.bgpills{position:absolute;z-index:40;right:30px;top:calc(50% + 193px);display:flex;flex-direction:column;gap:8px}
.bgpill{--pill:var(--accent);position:relative;width:28px;height:28px;padding:0;border-radius:50%;display:grid;place-items:center;border:1px solid var(--pill);background:rgba(3,8,12,.86);color:var(--pill);font:700 11px ui-monospace,SFMono-Regular,Consolas,monospace;cursor:pointer;backdrop-filter:blur(12px);box-shadow:0 0 12px color-mix(in srgb,var(--pill) 35%,transparent);transition:transform .15s,background-color .15s}
.bgpill.bad{--pill:var(--danger)}.bgpill.warn{--pill:var(--warn)}.bgpill.ok{--pill:var(--ok)}
.bgpill:hover,.bgpill.active{transform:scale(1.12);background:color-mix(in srgb,var(--pill) 18%,#03080c)}
.bgpill:focus-visible{outline:1px solid var(--pill);outline-offset:3px}
.bgpill.bad::after{content:'';position:absolute;inset:-4px;border-radius:50%;border:1px solid var(--pill);opacity:.5;animation:pulse 1.6s ease-in-out infinite;pointer-events:none}
.bgpop{position:fixed;z-index:75;width:min(360px,calc(100vw - 24px));max-height:min(420px,calc(100vh - 24px));display:flex;flex-direction:column;background:rgba(6,13,19,.97);border:1px solid var(--line);border-top:2px solid var(--accent);border-radius:10px;box-shadow:0 18px 50px rgba(0,0,0,.65)}
.bgpop.bad{border-top-color:var(--danger)}.bgpop.warn{border-top-color:var(--warn)}.bgpop.ok{border-top-color:var(--ok)}
.bgpop header{display:flex;align-items:center;gap:8px;padding:10px 10px 8px 12px;border-bottom:1px solid var(--line);font-size:11px;letter-spacing:.1em;text-transform:uppercase}
.bgpop header .dot{margin-top:0}
.bgpop header strong{flex:1 1 auto;min-width:0}
.bgpop .bglist{overflow:auto;min-height:0;padding:4px}
.bgitem{display:flex;align-items:flex-start;gap:9px;width:100%;padding:8px;background:none;border:0;border-radius:6px;color:var(--text);font:inherit;font-size:13px;text-align:left;cursor:pointer}
.bgitem:hover,.bgitem:focus-visible{outline:none;background:rgba(110,231,255,.08)}
.bgpop footer{display:flex;gap:8px;justify-content:flex-end;padding:8px 10px;border-top:1px solid var(--line)}
.bgpop footer .action{padding:6px 10px;font-size:12px}
@media(prefers-reduced-motion:reduce){.bgpill,.bgpill.bad::after{animation:none;transition:none}}

/* ---------- Fenêtre de réglages ---------- */
.overlay{position:fixed;inset:0;z-index:60;display:none;place-items:center;padding:3vh 3vw;background:rgba(2,6,10,.68);backdrop-filter:blur(7px)}
.overlay.open{display:grid}
.modal{width:82vw;height:82vh;display:grid;grid-template-rows:auto minmax(0,1fr) auto;background:var(--solid);border:1px solid var(--line);box-shadow:0 34px 90px rgba(0,0,0,.65);overflow:hidden}
.modal>header{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:16px 22px;border-bottom:1px solid var(--line)}
.modal>header h2{margin:0;font-size:14px;letter-spacing:.16em;text-transform:uppercase}
.modal>header .sub{font-size:11px;color:var(--muted);letter-spacing:.04em;text-transform:none}
.modal>header button{background:none;border:0;color:var(--muted);font-size:24px;line-height:1;cursor:pointer}
.modal>header button:hover{color:var(--text)}
.split{display:grid;grid-template-columns:212px minmax(0,1fr);min-height:0}
nav.tabs{border-right:1px solid var(--line);padding:14px 0;overflow:auto}
nav.tabs button{display:block;width:100%;text-align:left;padding:11px 20px;background:none;border:0;border-left:2px solid transparent;color:var(--muted);font:inherit;font-size:13px;cursor:pointer;letter-spacing:.05em}
nav.tabs button:hover{color:var(--text)}
nav.tabs button.active{color:var(--accent);border-left-color:var(--accent);background:rgba(110,231,255,.06)}
.content{overflow:auto;padding:24px 28px 32px;min-height:0}
.content>section{max-width:760px}
.content h3{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:26px 0 12px;font-weight:normal}
.content h3:first-child{margin-top:0}
.field{display:grid;gap:6px;margin-bottom:18px}
.field>label{font-size:12px;color:var(--muted)}
.field input,.field select{width:100%;background:#071015;border:1px solid var(--line);color:var(--text);padding:9px;border-radius:5px;font:inherit}
.field input:focus,.field select:focus{outline:none;border-color:var(--accent)}
.field.inline{grid-template-columns:auto 1fr;align-items:center;gap:10px}
.field.inline input[type=checkbox]{width:16px;height:16px;accent-color:var(--accent)}
.choices{display:grid;gap:10px;margin-bottom:20px}
.choice{display:grid;grid-template-columns:auto 1fr;gap:12px;align-items:start;border:1px solid var(--line);border-radius:8px;padding:13px 15px;cursor:pointer;background:#060d12}
.choice:hover{border-color:rgba(110,231,255,.4)}
.choice.selected{border-color:var(--accent);background:rgba(110,231,255,.06)}
.choice input{margin-top:3px;accent-color:var(--accent)}
.choice .title{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
.choice .title strong{font-weight:normal;letter-spacing:.04em}
.tag{font-size:10px;letter-spacing:.08em;text-transform:uppercase;border:1px solid var(--line);border-radius:3px;padding:1px 6px;color:var(--muted)}
.tag.ok{color:var(--ok);border-color:rgba(104,224,160,.45)}
.tag.bad{color:var(--danger);border-color:rgba(255,101,119,.45)}
.tag.warn{color:var(--warn);border-color:rgba(255,184,92,.45)}
.source{font-size:11px;color:var(--muted);display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.note.bad{color:var(--danger)}
.note.warn{color:var(--warn)}
.linkish{background:none;border:0;color:var(--accent);font:inherit;font-size:11px;cursor:pointer;padding:0;text-decoration:underline dotted}
.linkish:disabled{opacity:.38;cursor:default;text-decoration:none;pointer-events:none}
/* Un profil éteint garde ses réglages lisibles mais n'invite plus à les
   changer : il ne sert plus tant qu'il n'est pas rallumé. Le gris ne fait que
   le montrer — ce sont les attributs `disabled` posés sur chaque commande qui
   l'imposent, au clavier comme à la souris. */
.routing-off{opacity:.5}
table.keys{width:100%;border-collapse:collapse;font-size:13px}
table.keys th{text-align:left;font-weight:normal;font-size:10px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);padding:0 10px 8px 0;border-bottom:1px solid var(--line)}
table.keys td{padding:10px 10px 10px 0;border-bottom:1px solid rgba(113,144,160,.12);vertical-align:middle}
table.keys input[type=radio]{accent-color:var(--accent)}
.keyform{display:grid;grid-template-columns:170px 1fr 1fr auto;gap:10px;align-items:end;margin-top:8px}
.keyform .field{margin:0}
.shortcut{display:grid;grid-template-columns:1fr 190px;gap:14px;align-items:center;padding:12px 0;border-bottom:1px solid rgba(113,144,160,.12)}
.shortcut .desc{font-size:11px;color:var(--muted);line-height:1.5;margin-top:3px}
.keycap{width:100%;border:1px solid var(--line);background:#0b141a;color:var(--text);padding:9px;border-radius:5px;font:inherit;cursor:pointer;text-align:center;letter-spacing:.06em}
.keycap:hover{border-color:var(--accent)}
.keycap.capturing{border-color:var(--accent);color:var(--accent);animation:pulse 1.1s ease-in-out infinite}
@keyframes pulse{50%{opacity:.45}}
.modal>footer{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:14px 22px;border-top:1px solid var(--line)}
.modal>footer .status{font-size:12px;color:var(--muted);min-height:16px}
.modal>footer .status.ok{color:var(--ok)}
.modal>footer .status.error{color:var(--danger)}
.notice{border-left:2px solid var(--warn);padding:10px 14px;margin:0 0 18px;background:rgba(255,184,92,.06);font-size:12px;line-height:1.6;color:#e4d3b8}
.notice.bad{border-left-color:var(--danger);background:rgba(255,101,119,.07);color:#f0c3c9}
.notice.ok{border-left-color:var(--ok);background:rgba(104,224,160,.06);color:#cdeedd}
.notice.info{border-left-color:var(--line);background:rgba(113,144,160,.06);color:var(--text)}
.notice .hint{margin-top:4px}
.notice code,.kv code{word-break:break-all}
details.rd{border:1px solid var(--line);border-radius:6px;padding:10px 14px;margin:0 0 18px}
details.rd>summary{cursor:pointer;font-size:12px;color:var(--muted);letter-spacing:.04em}
details.rd[open]>summary{margin-bottom:14px}
.hint.agsource{margin:0 2px 8px}
/* ---------- Catalogue partagé (Agent/CLI + Voice) ---------- */
.catalog-shell{display:grid;gap:14px;max-width:none}
.catalog-toolbar{display:grid;grid-template-columns:minmax(220px,1fr) minmax(170px,240px);gap:12px;align-items:end}
.catalog-toolbar label{display:grid;gap:6px;font-size:11px;color:var(--muted)}
.catalog-toolbar input,.catalog-toolbar select{width:100%;background:#071015;border:1px solid var(--line);color:var(--text);padding:9px;border-radius:5px;font:inherit}
.catalog-toolbar input:focus-visible,.catalog-toolbar select:focus-visible,.catalog-filter input:focus-visible,.catalog-table button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.catalog-filters{display:flex;gap:8px;overflow-x:auto;padding:1px 1px 5px}
.catalog-filter{display:flex;gap:8px;align-items:center;min-width:max-content;margin:0;padding:7px 9px;border:1px solid var(--line);border-radius:6px}
.catalog-filter legend{padding:0 4px;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.catalog-filter label{font-size:11px;color:var(--text);white-space:nowrap}.catalog-filter input{accent-color:var(--accent)}
.catalog-summary{font-size:11px;color:var(--muted)}
.catalog-notice,.catalog-empty{border-left:2px solid var(--line);padding:11px 13px;background:rgba(113,144,160,.06);font-size:12px;line-height:1.5}
.catalog-notice.error{border-left-color:var(--danger);color:#f0c3c9}.catalog-notice.no_credentials,.catalog-notice.partial{border-left-color:var(--warn);color:#e4d3b8}
.catalog-table-wrap{width:100%;overflow:auto;border:1px solid var(--line);border-radius:7px}
.catalog-table{width:100%;border-collapse:collapse;font-size:12px}.catalog-table caption{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.catalog-table thead th{position:sticky;top:0;z-index:1;text-align:left;font-weight:normal;font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);background:#071015;padding:9px;border-bottom:1px solid var(--line)}
.catalog-table tbody th,.catalog-table td{min-width:110px;padding:10px 9px;border-bottom:1px solid rgba(113,144,160,.12);vertical-align:top;text-align:left;font-weight:normal}.catalog-table tr:last-child :is(th,td){border-bottom:0}
.catalog-table tr:hover :is(th,td){background:rgba(110,231,255,.025)}.catalog-table input[type=checkbox]{accent-color:var(--accent)}
.catalog-cell-compare{min-width:76px!important;width:76px;text-align:center}.catalog-cell-model{min-width:180px!important}.catalog-cell-availability{min-width:210px!important}
.catalog-model-id,.catalog-reason{display:block;margin-top:4px;color:var(--muted);font-size:10px;line-height:1.4;word-break:break-word}
.catalog-chip{display:inline-block;margin:0 3px 3px 0;padding:1px 5px;border:1px solid var(--line);border-radius:3px;color:#a9c5d2;font-size:10px}
.catalog-unknown{color:var(--muted)}.catalog-status{display:inline-block;padding:2px 6px;border:1px solid var(--line);border-radius:10px;font-size:10px;white-space:nowrap}
.catalog-status.ok{color:var(--ok);border-color:rgba(104,224,160,.45)}.catalog-status.warn{color:var(--warn);border-color:rgba(255,184,92,.45)}.catalog-status.bad{color:var(--danger);border-color:rgba(255,101,119,.45)}
.catalog-evidence{margin-top:5px;color:var(--muted);font-size:10px}.catalog-evidence summary{cursor:pointer}.catalog-evidence ul{margin:5px 0 0;padding-left:18px}
.agent-catalog-head{display:flex;align-items:start;justify-content:space-between;gap:12px;margin-bottom:10px}.agent-catalog-head .hint{max-width:620px}
.voice-tabs{display:flex;gap:6px;overflow-x:auto;padding:2px 1px 10px;margin-bottom:12px;border-bottom:1px solid var(--line);scrollbar-width:thin}
.voice-tabs button{flex:0 0 auto;border:1px solid var(--line);border-radius:16px;padding:7px 11px;background:#071015;color:var(--muted);font:inherit;font-size:11px;cursor:pointer}
.voice-tabs button[aria-selected=true]{border-color:var(--accent);color:var(--accent);background:rgba(110,231,255,.07)}
.voice-tabs button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.voice-category-head{display:flex;align-items:center;justify-content:space-between;gap:12px}.voice-category-head h3{margin-top:0}
.voice-field-label{display:block;margin-bottom:6px;color:var(--text);font-size:12px}.field output{display:block;color:var(--text)}
@media(max-width:900px){
  .modal{width:94vw;height:88vh}
  .split{grid-template-columns:1fr;grid-template-rows:auto minmax(0,1fr)}
  nav.tabs{display:flex;border-right:0;border-bottom:1px solid var(--line);padding:0;overflow-x:auto}
  nav.tabs button{border-left:0;border-bottom:2px solid transparent;white-space:nowrap;padding:12px 16px}
  nav.tabs button.active{border-left:0;border-bottom-color:var(--accent)}
  .keyform{grid-template-columns:1fr}
}
@media(max-width:700px){
  .panel{left:12px;right:76px;top:12px;bottom:12px;width:auto}
  .dock{right:10px}
  .bgpills{right:22px}
  .topbar{left:10px;right:74px}
  .live-banner{top:62px;left:10px;right:74px;width:auto;transform:none;grid-template-columns:auto minmax(0,1fr)}
  .live-stop{grid-column:1/-1;width:100%}
  .brand{display:none}
  .catalog-toolbar{grid-template-columns:1fr}
  .catalog-table-wrap{overflow:visible;border:0}
  .catalog-table thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
  .catalog-table,.catalog-table tbody,.catalog-table tr,.catalog-table tbody th,.catalog-table td{display:block;width:100%}
  .catalog-table tr{margin-bottom:10px;border:1px solid var(--line);border-radius:7px;background:#060d12;overflow:hidden}
  .catalog-table tbody th,.catalog-table td{display:grid;grid-template-columns:minmax(92px,32%) minmax(0,1fr);gap:8px;min-width:0!important;border-bottom:1px solid rgba(113,144,160,.12)}
  .catalog-table tbody th::before,.catalog-table td::before{content:attr(data-label);font-size:9px;letter-spacing:.07em;text-transform:uppercase;color:var(--muted)}
  .catalog-cell-compare{text-align:left}
  .voice-tabs{margin-left:-4px;margin-right:-4px;padding-left:4px;padding-right:4px}
}
/* ---------- Chronologie de conversation (plein écran) ----------
   Quatre lanes sur un même axe vertical : Utilisateur (blanc), Jarvis · voix
   (bleu clair), Brain (orange), Sous-agents (blocs rouges). La couleur double
   toujours une étiquette, une icône ou un texte. Logique et rendu des entrées :
   control_center_timeline.js. */
.tl{--tl-user:#f4f7f9;--tl-mouth:#8fd0ff;--tl-brain:#ff9b45;--tl-sub:#ff5f5f;--tl-ruler:76px;--tl-lane:132px;
  position:fixed;inset:0;z-index:55;display:grid;grid-template-rows:auto auto minmax(0,1fr);
  background:rgba(2,6,10,.82);backdrop-filter:blur(16px) saturate(.85);-webkit-backdrop-filter:blur(16px) saturate(.85)}
.tl .sr,.tlab .sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
.tl-bar{display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;padding:12px 18px;border-bottom:1px solid var(--line);background:rgba(4,9,13,.72)}
.tl-title{display:flex;align-items:center;gap:9px;margin:0 6px 0 0;font-size:13px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap}
.tl-title svg{width:17px;height:17px;color:var(--accent)}
.tl-field{display:flex;align-items:center;gap:7px;font-size:11px;color:var(--muted);letter-spacing:.04em}
.tl-field select{max-width:300px;background:#071015;border:1px solid var(--line);color:var(--text);padding:6px 8px;border-radius:5px;font:inherit;font-size:12px}
.tl-field select:focus-visible,.tl-seg input:focus-visible+span,.tl-x:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.tl-seg{display:flex;margin:0;padding:0;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.tl-seg legend{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
.tl-seg label{position:relative;cursor:pointer}
.tl-seg input{position:absolute;opacity:0;inset:0;margin:0;cursor:pointer}
.tl-seg span{display:block;padding:6px 11px;font-size:12px;color:var(--muted)}
.tl-seg label+label span{border-left:1px solid var(--line)}
.tl-seg input:checked+span{color:var(--accent);background:rgba(110,231,255,.08)}
.tl-status{display:flex;align-items:center;gap:8px;flex:1 1 220px;min-width:0;font-size:12px}
.tl-status strong{font-weight:700;white-space:nowrap}
.tl-status span:last-child{color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-variant-numeric:tabular-nums}
.tl-led{flex:none;width:9px;height:9px;border-radius:50%;background:var(--muted)}
.tl-status[data-tone=live] .tl-led{background:var(--ok);animation:breathe 1.6s ease-in-out infinite}
.tl-status[data-tone=live] strong{color:var(--ok)}
.tl-status[data-tone=busy] .tl-led{background:var(--accent);animation:breathe .9s ease-in-out infinite}
.tl-status[data-tone=warn] .tl-led{background:var(--warn);animation:pulse 1.2s ease-in-out infinite}
.tl-status[data-tone=warn] strong{color:var(--warn)}
.tl-status[data-tone=bad] .tl-led{background:var(--danger)}
.tl-status[data-tone=bad] strong{color:var(--danger)}
/* Recherche, transcription, export (Slice 06) : boutons de la barre, panneaux dans le tiroir. */
.tl-acts{display:flex;gap:6px}
.tl-act{display:inline-flex;align-items:center;gap:6px;min-height:32px;padding:5px 10px;border:1px solid var(--line);border-radius:6px;background:#071015;color:var(--text);font:inherit;font-size:12px;cursor:pointer;white-space:nowrap}
.tl-act svg{width:15px;height:15px;flex:none;color:var(--accent)}
.tl-act:hover,.tl-act[aria-expanded=true]{border-color:var(--accent)}
.tl-act[aria-expanded=true]{background:rgba(110,231,255,.08)}
.tl-act:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.tl-sform{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.tl-sfield{flex:1 1 220px;min-width:0}
.tl-sfield input{box-sizing:border-box;width:100%;background:#071015;border:1px solid var(--line);color:var(--text);padding:7px 9px;border-radius:5px;font:inherit;font-size:13px}
.tl-sfield input:focus-visible,.tl-check input:focus-visible,.tl-hit:focus-visible,.tl-tx:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.tl-check{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)}
.tl-pstate{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;margin:12px 0 0;font-size:12px;line-height:1.5;font-variant-numeric:tabular-nums}
.tl-pstate>span{flex:1 1 200px;min-width:0;overflow-wrap:anywhere}
.tl-pstate[data-tone=bad] strong{color:var(--danger)}.tl-pstate[data-tone=ok] strong{color:var(--ok)}.tl-pstate[data-tone=muted] strong{font-weight:normal;color:var(--muted)}
.tl-hits{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:6px}
.tl-hit{display:grid;gap:3px;width:100%;box-sizing:border-box;padding:8px 10px;border:1px solid rgba(113,144,160,.22);border-radius:6px;background:#050b10;color:var(--text);font:inherit;text-align:left;cursor:pointer}
.tl-hit:hover{border-color:var(--accent)}
.tl-hmeta{font-size:10.5px;color:var(--muted);font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.tl-hwho{color:var(--text)}.tl-hconv{color:var(--warn)}
.tl-hsnip{font-size:12.5px;line-height:1.5;white-space:normal;overflow-wrap:anywhere}
.tl-hsnip mark{background:rgba(110,231,255,.22);color:#fff;border-radius:2px;padding:0 1px}
.tl-hfield{font-size:10.5px;color:#7d97a4}
.tl-prow{display:flex;flex-wrap:wrap;align-items:center;gap:8px}
.tl-pconv code{word-break:break-all}
.tl-tx{margin:12px 0 0;padding:10px 12px;border:1px solid rgba(113,144,160,.2);border-radius:6px;background:#050b10;font-size:12px;line-height:1.55;white-space:pre-wrap;overflow-wrap:anywhere}
.tl-e.is-found{box-shadow:0 0 0 2px var(--accent),0 0 0 5px rgba(110,231,255,.25)}
.tl-bar{position:relative;padding-right:60px}
.tl-bar>.tl-x{position:absolute;top:4px;right:8px}
.tl-x{min-width:44px;min-height:44px;background:none;border:1px solid transparent;border-radius:6px;color:var(--muted);font-size:22px;line-height:1;padding:0;cursor:pointer}
.tl-x:hover{color:var(--text);border-color:var(--line)}
.tl-notice{grid-row:2;margin:0;padding:8px 18px;font-size:12px;color:#e4d3b8;background:rgba(255,184,92,.07);border-bottom:1px solid rgba(255,184,92,.25)}
.tl-main{grid-row:3;position:relative;display:grid;grid-template-columns:minmax(0,1fr);min-height:0}
.tl-scroll{position:relative;overflow:auto;min-height:0;scrollbar-color:#23404f transparent;outline:none}
.tl-scroll:focus-visible{box-shadow:inset 0 0 0 2px var(--accent)}
/* Colonnes par défaut ; la page impose ensuite les largeurs pondérées calculées par `layout`. */
.tl-heads,.tl-canvas{display:grid;grid-template-columns:var(--tl-ruler) repeat(4,minmax(var(--tl-lane),1fr))}
.tl-heads{position:sticky;top:0;z-index:8;background:rgba(3,8,12,.94);border-bottom:1px solid var(--line)}
.tl-hcell{--c:var(--muted);display:flex;align-items:center;gap:7px;min-width:0;padding:10px 10px 9px;font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--text);box-shadow:inset 0 -2px 0 var(--c)}
.tl-hcell svg{width:15px;height:15px;flex:none;color:var(--c)}
.tl-hcell>span:first-of-type{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.tl-hruler{position:sticky;left:0;z-index:2;background:rgba(3,8,12,.98);color:var(--muted);box-shadow:none;font-weight:normal}
.tl-count{margin-left:auto;padding:0 6px;border:1px solid var(--line);border-radius:9px;font-size:10px;font-weight:normal;letter-spacing:.02em;color:var(--muted);font-variant-numeric:tabular-nums}
.tl [data-lane=user]{--c:var(--tl-user)}.tl [data-lane=mouth]{--c:var(--tl-mouth)}.tl [data-lane=brain]{--c:var(--tl-brain)}.tl [data-lane=subagent]{--c:var(--tl-sub)}
.tl-canvas{position:relative}
.tl-ruler{position:sticky;left:0;z-index:6;background:rgba(3,8,12,.9);border-right:1px solid var(--line)}
.tl-lane{position:relative;border-left:1px solid rgba(113,144,160,.1)}
.tl-lane[data-lane=subagent]{background:rgba(255,95,95,.018)}
.tl-lempty{position:sticky;top:52px;margin:10px;font-size:11px;line-height:1.5;color:var(--muted)}
.tl-grid,.tl-items,.tl-breaks{position:absolute;inset:0;pointer-events:none}
.tl-items{pointer-events:auto;z-index:2}
.tl-breaks{z-index:4}
.tl-tick{position:absolute;right:8px;transform:translateY(-50%);font-size:10px;color:#58727f;font-variant-numeric:tabular-nums;white-space:nowrap}
.tl-tick.major{color:#a9c5d2}
.tl-gl{position:absolute;left:var(--tl-ruler);right:0;height:1px;background:rgba(143,208,255,.05)}
.tl-gl.major{background:rgba(143,208,255,.12)}
.tl-break{position:absolute;left:var(--tl-ruler);right:0;display:flex;align-items:center;justify-content:center;border-top:1px dashed #23404f;border-bottom:1px dashed #23404f;
  background:repeating-linear-gradient(-45deg,rgba(3,7,11,.94) 0 7px,rgba(9,17,24,.94) 7px 14px)}
.tl-break span{padding:2px 9px;border-radius:9px;background:#050b10;font-size:10.5px;color:var(--muted);letter-spacing:.04em}
.tl-empty{position:absolute;left:50%;top:90px;z-index:7;transform:translateX(-50%);width:min(520px,calc(100% - 32px));display:grid;gap:8px;justify-items:center;padding:22px 24px;text-align:center;
  background:rgba(5,11,16,.92);border:1px dashed var(--line);border-radius:10px;line-height:1.55}
.tl-empty strong{font-size:14px;color:var(--text)}.tl-empty span{font-size:12px;color:var(--muted)}
.tl-empty[data-tone=bad]{border-color:rgba(255,101,119,.5)}.tl-empty[data-tone=bad] strong{color:var(--danger)}
.tl-empty[data-tone=warn]{border-color:rgba(255,184,92,.5)}.tl-empty[data-tone=warn] strong{color:var(--warn)}
/* Entrées (control_center_timeline.js, entryKind) :
   card    texte public jamais coupé : la carte grandit, barre de 3 px = durée exacte ;
   failure carte rouge, libellé toujours visible ;
   dot     repère diagnostique sur le rail gauche, libellé au survol ou au focus ;
   bar     travail du Brain / outil, barre étroite sur le rail droit ;
   block   sous-agent, bloc rouge de durée exacte, texte à l'intérieur.
   Les hauteurs d'une carte suivent GEOMETRY : 1 + 5 + 14 + 2 + n×16 + 6 + 1. */
.tl-e{--c:var(--tl-brain);position:absolute;display:block;box-sizing:border-box;margin:0;padding:0;border:0;background:none;color:var(--text);font:inherit;text-align:left;cursor:pointer}
.tl-e.tl-user{--c:var(--tl-user);cursor:default}.tl-e.tl-mouth{--c:var(--tl-mouth)}.tl-e.tl-subagent{--c:var(--tl-sub)}
.tl-e:focus-visible{outline:2px solid var(--accent);outline-offset:2px;z-index:6}
.tl-measure{position:absolute;visibility:hidden;white-space:pre;font-size:12.5px;line-height:16px}
.tl-card,.tl-failure{display:flex;flex-direction:column;justify-content:flex-start;padding:5px 8px 6px 12px;border-radius:6px;border:1px solid color-mix(in srgb,var(--c) 38%,transparent);background:color-mix(in srgb,var(--c) 9%,#060c12);transition:border-color .15s}
.tl-user.tl-card{background:rgba(244,247,249,.07);border-color:rgba(244,247,249,.34)}
.tl-e:not(.tl-user):hover{border-color:var(--c)}
.tl-h{display:flex;flex-wrap:wrap;align-items:center;gap:0 6px;margin-bottom:2px;font-size:10.5px;line-height:14px;color:color-mix(in srgb,var(--c) 72%,#9fb6c2);font-variant-numeric:tabular-nums}
.tl-dl{color:var(--text)}
.tl-st{padding:0 4px;border:1px solid currentColor;border-radius:3px;font-size:9px;line-height:12px;letter-spacing:.07em;text-transform:uppercase}
.tl-e.is-warn .tl-st{color:var(--warn)}.tl-e.is-bad .tl-st{color:var(--danger)}.tl-e.is-live .tl-st{color:var(--accent)}
.tl-t{display:block;font-size:12.5px;line-height:16px;color:#e3eef3;white-space:pre-wrap;overflow-wrap:anywhere}
.tl-user .tl-t{color:#fff}
.tl-e.is-diag .tl-t{color:#c8d8e0}
.tl-e.is-unheard .tl-t{color:#aebfc8;font-style:italic}
/* Durée exacte d'une parole : barre de 3 px depuis le début ; ambre en bout quand la parole est coupée. */
.tl-durbar{position:absolute;left:3px;top:0;width:3px;border-radius:2px;background:var(--c);z-index:1}
.tl-e.st-interrupted .tl-durbar{background:linear-gradient(var(--c),var(--c)) top/100% calc(100% - 5px) no-repeat,var(--warn)}
.tl-e.st-open .tl-durbar{background:linear-gradient(var(--c) 70%,transparent)}
.tl-failure{--c:var(--danger);border-color:rgba(255,101,119,.65);background:rgba(255,101,119,.08)}
.tl-failure .tl-h,.tl-failure .tl-t{color:#ffc7ce}
.tl-ico{width:12px;height:12px;flex:none;color:var(--danger)}
/* Repères : un point sur le rail, le libellé apparaît au survol et au focus clavier. */
.tl-dot{border-radius:50%}
.tl-d{position:absolute;left:4px;top:4px;width:10px;height:10px;box-sizing:border-box;border-radius:50%;border:1.5px solid var(--c);background:#050b10}
.tl-dot.dot-diamond .tl-d{border-radius:2px;transform:scale(.85) rotate(45deg)}
/* Position fixe (le conteneur .tl, flouté, est le bloc de référence) : placée par placeTips() dans la zone visible. */
.tl-tip{display:none;position:fixed;left:-9999px;top:0;z-index:30;box-sizing:border-box;width:max-content;max-width:min(28rem,calc(100vw - 32px));padding:4px 9px;border-radius:8px;border:1px solid var(--c);background:#050b10;font-size:11px;line-height:15px;color:var(--text);white-space:normal;overflow-wrap:anywhere;overflow:hidden;box-shadow:0 6px 18px rgba(0,0,0,.5);pointer-events:none}
.tl-dot:hover,.tl-dot:focus-visible{z-index:20}
.tl-dot:hover .tl-tip,.tl-dot:focus-visible .tl-tip,.tl-dot.is-selected .tl-tip{display:block}
/* Travaux et outils : barre étroite, libellé vertical quand elle est assez haute. */
.tl-railbar{border-radius:3px;border:1px solid var(--c);background:color-mix(in srgb,var(--c) 22%,transparent);overflow:hidden}
.tl-railbar.tl-tool{border-style:dashed;background:color-mix(in srgb,var(--c) 10%,transparent)}
.tl-railbar.is-bad{border-color:var(--danger);background:repeating-linear-gradient(135deg,rgba(255,101,119,.32) 0 5px,transparent 5px 10px)}
.tl-railbar.st-open{border-bottom-style:dashed;-webkit-mask:linear-gradient(#000 calc(100% - 18px),rgba(0,0,0,.35));mask:linear-gradient(#000 calc(100% - 18px),rgba(0,0,0,.35))}
.tl-vl{position:absolute;top:4px;bottom:4px;left:0;width:12px;writing-mode:vertical-rl;font-size:10.5px;line-height:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:color-mix(in srgb,var(--c) 82%,#fff)}
/* Sous-agents : bloc de durée exacte, nom, description et heure à l'intérieur. */
.tl-block{display:flex;flex-direction:column;justify-content:flex-start;padding:6px 8px 6px 10px;border-radius:6px;overflow:hidden}
.tl-fill{position:absolute;left:0;right:0;top:0;box-sizing:border-box;border-radius:6px;border:1px solid var(--tl-sub);background:color-mix(in srgb,var(--tl-sub) 24%,transparent)}
.tl-block.is-short{border:1px dashed color-mix(in srgb,var(--tl-sub) 55%,transparent)}
.tl-block.is-bad .tl-fill{background:repeating-linear-gradient(135deg,rgba(255,101,119,.24) 0 6px,transparent 6px 12px),color-mix(in srgb,var(--tl-sub) 12%,transparent);border-color:var(--danger)}
.tl-block.st-open .tl-fill{border-bottom:0;-webkit-mask:linear-gradient(#000 calc(100% - 26px),transparent);mask:linear-gradient(#000 calc(100% - 26px),transparent)}
.tl-bn,.tl-bd{position:relative;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;font-size:12.5px;line-height:16px;overflow-wrap:anywhere}
.tl-bn{font-weight:700;color:#fff}.tl-bd{color:#f3d2d2}
.tl-bm{position:relative;display:flex;flex-wrap:wrap;gap:0 5px;align-items:center;font-size:10.5px;line-height:16px;color:#ffb3b3;font-variant-numeric:tabular-nums;white-space:nowrap}
.tl-e.is-selected{box-shadow:0 0 0 2px var(--c),0 6px 22px rgba(0,0,0,.45)}
.tl-new{position:absolute;left:50%;bottom:16px;z-index:9;margin:0;transform:translateX(-50%)}
.tl-drawer{display:flex;flex-direction:column;min-height:0;background:var(--solid);border-left:1px solid var(--line)}
.tl-drawer[data-lane=user]{box-shadow:inset 0 2px 0 var(--tl-user)}.tl-drawer[data-lane=mouth]{box-shadow:inset 0 2px 0 var(--tl-mouth)}
.tl-drawer[data-lane=brain]{box-shadow:inset 0 2px 0 var(--tl-brain)}.tl-drawer[data-lane=subagent]{box-shadow:inset 0 2px 0 var(--tl-sub)}
.tl-drawer>header{display:flex;align-items:center;gap:10px;padding:12px 14px 11px 16px;border-bottom:1px solid var(--line)}
.tl-drawer h3{flex:1 1 auto;min-width:0;margin:0;font-size:12px;line-height:16px;letter-spacing:.1em;text-transform:uppercase;overflow:hidden;overflow-wrap:anywhere;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2}
.tl-drawer .tl-x{margin-left:0}
.tl-dbody{padding:14px 16px 28px;overflow:auto;min-height:0}
.tl-dhead{display:flex;flex-wrap:wrap;gap:6px}
.tl-dtext{margin:12px 0 0;font-size:13px;line-height:1.55;white-space:pre-wrap;word-break:break-word}
.tl-dbody .notice{margin:12px 0 0}
.tl-dbody code{font-size:11px;color:#a9c5d2;word-break:break-all}
.tl-links{display:flex;flex-wrap:wrap;gap:6px}
.tl-list{margin:0;padding-left:18px;font-size:12px;line-height:1.6}
.tl-trace{margin-top:10px;padding-top:9px;border-top:1px dashed rgba(113,144,160,.2)}
.tl-trace p{margin:0 0 6px}
.tl-trace-head{display:grid;gap:3px;font-size:12px}
.tl-trace-head[data-tone=ok] strong{color:var(--ok)}.tl-trace-head[data-tone=bad] strong{color:var(--danger)}
.tl-trace-line{margin:8px 0;padding:8px 10px;border:1px solid rgba(113,144,160,.16);border-radius:6px;background:#050b10;font-size:12px}
.tl-trace-line .kv{margin-top:6px}
.tl-loading{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
@media(min-width:1100px){.tl.has-drawer .tl-main{grid-template-columns:minmax(0,1fr) min(440px,36vw)}}
@media(max-width:1099px){.tl-drawer{position:absolute;top:0;right:0;bottom:0;z-index:12;width:min(440px,100%);box-shadow:-18px 0 50px rgba(0,0,0,.6)}}
@media(max-width:700px){
  /* Écran étroit : barre d'outils compacte (titre en icône, libellés des champs
     lus par les lecteurs d'écran seulement), fermeture de 44 px. */
  .tl{--tl-ruler:54px}
  .tl-bar{gap:6px 8px;padding:6px 54px 6px 10px}
  .tl-bar>.tl-x{top:2px;right:4px}
  .tl-title{margin:0}
  .tl-tt,.tl-field>span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  .tl-field:first-of-type{flex:1 1 120px;min-width:0}
  .tl-field:first-of-type select{width:100%;max-width:none}
  #tlSessionWrap select{max-width:110px}
  /* Boutons en icônes sur la ligne de la conversation (titre, liste, actions) : pas de ligne de plus. */
  .tl-title{order:-3}.tl-field:first-of-type{order:-2}.tl-acts{order:-1;gap:4px}
  .tl-act{min-width:36px;min-height:36px;justify-content:center;padding:4px}
  .tl-al{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  .tl-seg span{padding:5px 9px}
  .tl-status{flex-basis:100%;order:10;font-size:11px}
  .tl-hcell{padding:8px 6px;letter-spacing:.06em;font-size:10px}
  .tl-tick{right:4px;font-size:9.5px}
}
@media(prefers-reduced-motion:reduce){.tl-status .tl-led{animation:none}.tl-card,.tl-failure{transition:none}}

/* ---------- Test Lab (plein écran) ----------
   Diagnostics ciblés de la catégorie 2 : choisir un diagnostic, voir AVANT de
   lancer ce que le profil exige et coûte, suivre l'exécution (invite guidée
   comprise), lire la preuve, comparer deux exécutions. Aucun verdict n'est
   calculé ici : l'écran affiche les documents du serveur (`docs/testlab.md`,
   « Control Center panel »). Rendu et logique : control_center_testlab.js.

   La coquille est celle de la chronologie (`.tl-bar`, `.tl-title`, `.tl-x`,
   `.tl-notice`, `.tl-loading`, rang 55) et le contenu réutilise les idiomes de
   la page (`.choice`, `.field`, `.notice`, `.chip`, `.tag`, `.kv`, `.empty`,
   `.catalog-table`) : le Test Lab ajoute une mise en page, pas un second style. */
.tlab{position:fixed;inset:0;z-index:55;display:grid;grid-template-rows:auto auto minmax(0,1fr);
  background:rgba(2,6,10,.82);backdrop-filter:blur(16px) saturate(.85);-webkit-backdrop-filter:blur(16px) saturate(.85)}
.tlab-env{display:flex;flex-wrap:wrap;align-items:center;gap:4px 6px;flex:1 1 300px;min-width:0;font-size:11px}
.tlab-env .chip{margin:0}
.tlab-sub{display:block;margin-top:3px;font-size:10.5px;line-height:1.45;color:var(--muted);overflow-wrap:anywhere}
/* La phrase que le serveur a écrite, citée : elle est en anglais comme ses
   codes, et elle ne doit pas se lire comme la suite de la phrase française qui
   l'introduit. C'est la preuve, pas un commentaire. */
.tlab-quote{display:block;margin-top:5px;padding-left:9px;border-left:1px solid currentColor;font-style:italic;opacity:.92;overflow-wrap:anywhere}
.tlab-bad{color:var(--danger)}
.tlab-notice-bad{color:#f0c3c9;background:rgba(255,101,119,.07);border-bottom-color:rgba(255,101,119,.3)}
.tlab-main{grid-row:3;display:grid;grid-template-columns:288px minmax(0,1fr);min-height:0}
.tlab-side{display:flex;flex-direction:column;min-height:0;border-right:1px solid var(--line);background:rgba(4,9,13,.55)}
.tlab-search{display:block;padding:12px 14px 10px;border-bottom:1px solid var(--line)}
.tlab-search input{width:100%;box-sizing:border-box;background:#071015;border:1px solid var(--line);color:var(--text);padding:8px 9px;border-radius:5px;font:inherit;font-size:12px}
.tlab-search input:focus-visible,.tlab-item:focus-visible,.tlab-tabs button:focus-visible,.tlab-run-row:focus-visible,.tlab-compare-form select:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.tlab-list{overflow:auto;min-height:0;padding:8px}
.tlab-item{display:block;width:100%;margin-bottom:6px;padding:10px 11px;border:1px solid var(--line);border-left:2px solid transparent;border-radius:7px;background:#060d12;color:var(--text);font:inherit;text-align:left;cursor:pointer}
.tlab-item:hover{border-color:rgba(110,231,255,.35);background:#08121a}
.tlab-item.is-selected{border-color:var(--accent);border-left-color:var(--accent);background:rgba(110,231,255,.06)}
.tlab-iname{display:block;font-size:13px;line-height:1.35;overflow-wrap:anywhere}
.tlab-iprof{display:block;margin-top:6px}
.tlab-iprof .chip{margin:0 4px 0 0}
.tlab-right{display:grid;grid-template-rows:auto minmax(0,1fr);min-height:0}
/* Suivi d'une exécution : hors de la zone qui défile, donc jamais perdu de vue
   pendant qu'on lit la preuve — une invite guidée que l'on fait défiler hors de
   l'écran est une étape que personne ne voit. */
.tlab-live{padding:13px 22px;border-bottom:1px solid var(--line);background:rgba(4,9,13,.72);max-height:56vh;overflow:auto}
.tlab-body{overflow:auto;min-height:0;padding:16px 22px 40px}
.tlab-body>*{max-width:940px}
.tlab-head h2{margin:0 0 6px;font-size:15px;letter-spacing:.02em}
.tlab-head p{margin:0 0 4px}
.tlab-tabs{display:flex;gap:6px;margin:16px 0 4px;padding-bottom:10px;border-bottom:1px solid var(--line)}
.tlab-tabs button{border:1px solid var(--line);border-radius:16px;padding:7px 13px;background:#071015;color:var(--muted);font:inherit;font-size:12px;cursor:pointer}
.tlab-tabs button[aria-selected=true]{border-color:var(--accent);color:var(--accent);background:rgba(110,231,255,.07)}
.tlab-sect{margin:18px 0 0}
.tlab-sect>h4{display:flex;align-items:center;gap:10px;margin:0 0 10px;font-size:10px;font-weight:normal;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.tlab-progress{display:grid;grid-template-columns:auto minmax(0,1fr) auto auto;gap:12px;align-items:center;padding:11px 13px;border:1px solid var(--line);border-radius:9px;background:#060d12}
.tlab-progress[data-tone=busy]{border-color:rgba(110,231,255,.4)}
.tlab-progress[data-tone=ok]{border-color:rgba(104,224,160,.45)}
.tlab-progress[data-tone=bad]{border-color:rgba(255,101,119,.45)}
.tlab-progress[data-tone=warn]{border-color:rgba(255,184,92,.45)}
.tlab-pmain{min-width:0}
.tlab-led{width:9px;height:9px;border-radius:50%;background:var(--muted)}
.tlab-progress[data-tone=busy] .tlab-led{background:var(--accent);animation:breathe 1.6s ease-in-out infinite}
.tlab-progress[data-tone=ok] .tlab-led{background:var(--ok)}
.tlab-progress[data-tone=bad] .tlab-led{background:var(--danger)}
.tlab-progress[data-tone=warn] .tlab-led{background:var(--warn)}
.tlab-elapsed{font-variant-numeric:tabular-nums;font-size:12px;color:#b9d0dc;white-space:nowrap}
/* Étape guidée : la personne EST l'instrument. Elle doit voir d'un coup d'œil
   quoi faire, quoi dire, combien de temps il reste et comment sortir. Le
   compte à rebours n'est qu'un affichage : le délai appartient à l'exécution,
   et les deux boutons restent actifs tant que l'invite est ouverte. */
.tlab-step{margin-top:10px;padding:14px 16px;border:1px solid rgba(255,184,92,.45);border-radius:9px;background:rgba(255,184,92,.06)}
.tlab-shead{display:flex;flex-wrap:wrap;align-items:center;gap:8px;font-size:13px}
.tlab-shead .chip,.tlab-shead .tag{margin:0}
.tlab-shead code{font-size:11px;color:var(--muted)}
.tlab-stext{margin:10px 0 0;font-size:15px;line-height:1.5;color:#fff}
.tlab-phrase{margin:9px 0 0;padding:9px 13px;border-left:2px solid var(--warn);background:rgba(0,0,0,.28);font-size:17px;line-height:1.4;color:#ffe2b8;overflow-wrap:anywhere}
.tlab-count{display:flex;align-items:center;gap:10px;margin:12px 0 6px;font-size:12px;font-variant-numeric:tabular-nums}
.tlab-gauge{flex:1 1 auto;height:6px;border-radius:3px;background:rgba(113,144,160,.22);overflow:hidden}
/* La jauge se contracte par `transform` et non par `width` : le compte à
   rebours est redessiné deux fois par seconde et ne doit rien faire remettre
   en page. */
.tlab-gauge span{display:block;width:100%;height:100%;background:var(--warn);transform-origin:left center;transition:transform .5s linear}
.tlab-snote{margin:0 0 10px;min-height:16px;font-size:11.5px;line-height:1.5;color:#e4d3b8}
/* Profils : ce que chacun exige à gauche, ce qu'il coûte à droite, et le refus
   à sa place quand il ne peut pas tourner ici. */
.tlab-profile .hint{margin-top:3px}
.tlab-profile.tlab-blocked{opacity:.8}
.tlab-req{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:8px 18px;margin-top:10px}
.tlab-req ul{margin:3px 0 0;padding-left:16px;font-size:11.5px;line-height:1.6;color:#a9c5d2}
.tlab-req code{font-size:10.5px;color:var(--muted)}
.tlab-k{font-size:9.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.tlab-profile .notice{margin:10px 0 0}
.tlab-param{margin-bottom:14px}
.tlab-launch{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-top:22px;padding-top:16px;border-top:1px solid var(--line)}
/* Verdict : le mot d'abord, ce qu'il veut dire ensuite, les faits après. */
.tlab-verdict{padding:13px 15px;border:1px solid var(--line);border-radius:9px;background:#060d12}
.tlab-verdict[data-tone=ok]{border-color:rgba(104,224,160,.5);background:rgba(104,224,160,.05)}
.tlab-verdict[data-tone=bad]{border-color:rgba(255,101,119,.5);background:rgba(255,101,119,.05)}
.tlab-verdict[data-tone=warn]{border-color:rgba(255,184,92,.5);background:rgba(255,184,92,.05)}
.tlab-verdict[data-tone=busy]{border-color:rgba(110,231,255,.45)}
.tlab-verdict strong{display:block;font-size:19px;letter-spacing:.01em}
.tlab-verdict>span{display:block;margin-top:4px;font-size:12.5px;line-height:1.55;color:#a9c5d2}
.tlab-vmeta{display:flex;flex-wrap:wrap;gap:4px;margin-top:9px}
.tlab-vmeta .chip{margin:0}
.tlab-evidence .notice{margin:12px 0 0}
.tlab-ehead{margin-bottom:12px}
.tlab-ehead h3{margin:0;font-size:13px;letter-spacing:.06em}
.tlab-num{font-variant-numeric:tabular-nums;white-space:nowrap}
.tlab-none{color:var(--warn)}
.tlab-artifacts{margin:0;padding:0;list-style:none;display:grid;gap:6px}
.tlab-artifacts li{padding:8px 10px;border:1px solid rgba(113,144,160,.22);border-radius:6px;background:#050b10;font-size:12px}
.tlab-artifacts a{color:var(--accent);word-break:break-all}
.tlab-inputs{margin-top:16px}
.tlab-loading{display:flex;align-items:center;gap:8px;font-size:12px;color:var(--muted)}
.tlab-two{display:grid;grid-template-columns:minmax(0,306px) minmax(0,1fr);gap:20px;align-items:start}
.tlab-runs{display:grid;gap:6px}
.tlab-run-row{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:9px;align-items:center;width:100%;padding:9px 10px;border:1px solid var(--line);border-radius:7px;background:#060d12;color:var(--text);font:inherit;text-align:left;cursor:pointer}
.tlab-run-row:hover{border-color:rgba(110,231,255,.35)}
.tlab-run-row.is-selected{border-color:var(--accent);background:rgba(110,231,255,.06)}
.tlab-run-row .dot{margin-top:0}
.tlab-rmain{min-width:0}
.tlab-rid{font-size:12px}
.tlab-rout{font-size:10px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.tlab-compare-form{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;gap:12px;align-items:end;margin-bottom:16px}
.tlab-compare-form .field{margin:0}
.tlab-compare-form select{width:100%;background:#071015;border:1px solid var(--line);color:var(--text);padding:9px;border-radius:5px;font:inherit;font-size:12px}
@media(max-width:1180px){.tlab-two{grid-template-columns:minmax(0,1fr)}}
@media(max-width:900px){
  .tlab-main{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}
  .tlab-side{border-right:0;border-bottom:1px solid var(--line);max-height:32vh}
