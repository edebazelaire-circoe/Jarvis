    'mouth.speech.started':['mouth',O,P],
    'mouth.speech.completed':['mouth',C,P],
    'mouth.speech.interrupted':['mouth',C,P],
    'mouth.speech.superseded':['mouth',C,D],
    'mouth.speech.expired':['mouth',C,D],
    'mouth.speech.failed':['mouth',C,D],
