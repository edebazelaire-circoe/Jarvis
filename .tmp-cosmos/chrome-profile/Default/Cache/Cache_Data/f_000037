  .tlab-progress{grid-template-columns:auto minmax(0,1fr);row-gap:8px}
  .tlab-elapsed,.tlab-progress .action{grid-column:2}
}
@media(prefers-reduced-motion:reduce){.tlab-progress[data-tone=busy] .tlab-led{animation:none}.tlab-gauge span{transition:none}}
