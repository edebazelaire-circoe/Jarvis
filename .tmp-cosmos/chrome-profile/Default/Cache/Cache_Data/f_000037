      +` width="${shapes.size}" height="${shapes.size}" fill="none" stroke="currentColor"`
      +` stroke-width="${shapes.strokeWidth}" stroke-linecap="round" stroke-linejoin="round"`
      +` data-bh-pose="${shapes.id}"${head}${inner}</svg>`;
