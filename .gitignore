__pycache__/
*.py[cod]
.pytest_cache/
.venv/
.env
/runtime/
data/memory/.jarvis/
third_party/barehands/
third_party/ai-visualizer/
third_party/.downloads/
third_party/INSTALL-STATE.json
/runtime/*.log

config/jarvis.toml

# Artefacts de test et etat runtime local
.pytest-tmp-*/
# Ancien emplacement des donnees locales (avant 2026-09-30). Elles vivent
# desormais hors du depot, dans ~/.jarvis/instances/<depot>/data (docs/local-data.md).
data/history/
data/memory/*_memory/
data/ADOPTED.json
data/state/*.sqlite3
data/state/*.sqlite3-shm
data/state/*.sqlite3-wal
data/state/*.bak
data/state/*.bak.partial

# Verification du locuteur : profil vocal du proprietaire (biometrique) et
# modeles telecharges. Le defaut vit sous /runtime/ ; ces motifs couvrent aussi
# un chemin de profil choisi dans le depot.
speaker-verification/
owner-voice-profile*.json
*.onnx

# Etat local Visual Studio
.vs/

# Worktrees et état local du CLI : un chantier n'est pas un sous-module.
.claude/
