    "props.headline",
    "props.theme.accent"
   ],
   "anchors": [
    {
     "anchor_id": "detail",
     "label": "Répartition",
     "control_id": "accent",
     "at_ms": 3000
    }
   ]
  }
 ],
 "art_direction": {
  "mode": "fallback"
 }
}